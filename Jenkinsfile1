pipeline {
    agent {
        label 'python-jenkins-agent'
    }

    options {
        skipDefaultCheckout(true)
    }
       stages {
        stage('Checkout') {
            steps {
                echo 'Downloading Python project from GitHub'
                checkout scm
                sh 'ls -la'
                  }
               }
        stage('Build') {
            steps {
                echo 'Building the Python application'

                sh 'python3 -m compileall -q script1.py'
                sh 'tar -czf python-app.tar.gz script1.py'
            }
        }

        stage('Run') {
            steps {
                echo 'Running the Python application'

                sh 'python3 script1.py'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
            archiveArtifacts artifacts: 'python-app.tar.gz'
        }

        failure {
            echo 'Pipeline failed!'
        }
    }
}
        
